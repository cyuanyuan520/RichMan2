# PeerJS broker overrides (optional). Defaults use the public PeerJS cloud broker.
NEXT_PUBLIC_PEERJS_HOST=
NEXT_PUBLIC_PEERJS_PORT=
NEXT_PUBLIC_PEERJS_PATH=
NEXT_PUBLIC_PEERJS_SECURE=
NEXT_PUBLIC_PEERJS_KEY=

# Extra ICE servers as a JSON array. When set, this REPLACES PeerJS' default ICE
# config, so include the public STUN servers you still rely on.
NEXT_PUBLIC_ICE_SERVERS=
